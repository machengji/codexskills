prefix_rule(pattern=["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "git config --global --add safe.directory D:/code/mall-erp; git -C d:\\code\\mall-erp diff -- mall-admin/src/main/java/com/ruoyi/web/service/client/EsignClient.java"], decision="allow")
