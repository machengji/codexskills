prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "Get-ChildItem -Path D:\\code\\mall-erp -Recurse -File | Where-Object { $_.Name -match 'report_order|ReportOrder|order' } | Select-Object -ExpandProperty FullName"], decision="allow")
prefix_rule(pattern=["C:\\Program Files\\PowerShell\\7\\pwsh.exe", "-Command", "$路径='C:\\Users\\Administrator\\.codex\\skills\\.system\\skill-creator\\SKILL.md'; $行=Get-Content -LiteralPath $路径 -Encoding UTF8; $行[120..280] -join \"`n\"; \"`n---续---`n\"; $行[281..($行.Count-1)] -join \"`n\""], decision="allow")
